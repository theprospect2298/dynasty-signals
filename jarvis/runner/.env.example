# ---- Model ----
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-4-8
ANTHROPIC_API_KEY=your-api-key
MAX_TOKENS=8000
# Cap on agentic tool-use turns per skill run (safety valve).
MAX_TOOL_ITERATIONS=60

# ---- Vault + memory ----
# Absolute path to your vault. Defaults to the bundled ../vault if unset.
VAULT_PATH=/Users/yourname/JARVIS-VAULT
MEMORY_BACKEND=sqlite
# Leave these commented to derive them from VAULT_PATH automatically.
# Only set them if your memory/outputs live somewhere other than the vault.
# MEMORY_PATH=/Users/yourname/JARVIS-VAULT/07-SYSTEM/memory/jarvis.db
# OUTPUT_PATH=/Users/yourname/JARVIS-VAULT/04-JARVIS-OUTPUTS

# Which paths the agent may WRITE to:
#   vault         -> anywhere inside the vault (lets capture-processor file notes,
#                    belief-tracker apply CLAUDE.md updates, etc.)
#   outputs-only  -> only 04-JARVIS-OUTPUTS (everything else becomes read-only)
WRITE_SCOPE=vault

# ---- Scheduler / always-on process (npm start) ----
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=America/New_York
# Two-way Telegram control bot — text your bot /brief, /capture, /find, /status.
ENABLE_TELEGRAM_BOT=true
# Run Mission Control inside the same process (handy on a server / in Docker).
# Leave false on your laptop and run "node src/cli.js mc start" separately.
ENABLE_MISSION_CONTROL=false

# ---- External intelligence ----
# Anthropic server-side web search powers the "external intelligence" steps.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=5

# ---- Retry ----
SKILL_RETRY_ENABLED=true
SKILL_RETRY_MAX=3
# Seconds between retries.
SKILL_RETRY_DELAY=300

# ---- Notifications ----
# telegram | none
NOTIFICATION_GATEWAY=telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ---- Mission Control (parallel worker orchestrator) ----
# How many worker agents may run at the same time.
MC_MAX_CONCURRENT=3
# How often the orchestrator checks the queue (seconds).
MC_POLL_SECONDS=5
# Safety cap: stop dispatching once estimated spend today crosses this (USD).
MC_DAILY_BUDGET_USD=5
# Estimated price per million tokens, used only for the budget estimate.
MC_PRICE_INPUT_PER_MTOK=15
MC_PRICE_OUTPUT_PER_MTOK=75
# Dry run = workers return a stub instead of calling the API (no cost).
# Set true to test the pipeline for free; false to do real work.
MC_DRY_RUN=false
# Auto-chaining guardrails: a client-finder lead auto-spawns brand-research,
# which auto-spawns outreach-drafter. These cap how far/wide that can cascade.
MC_MAX_DEPTH=4
MC_MAX_CHILDREN=25
